# External hosting only: use credentials from a backend you control.
# Lovable Cloud injects its managed settings on Lovable, not into Vercel.
# See DEPLOYMENT.md for migration and Vercel setup.
# These settings are server-only. Never prefix private keys with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Public browser settings. Must refer to the same backend as SUPABASE_URL.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never replay legacy supabase/migrations on the managed Cloud database.
# Never commit actual credentials; configure them in your host's secret settings.
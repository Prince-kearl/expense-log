
# Supabase project (Postgres + Auth + Storage). Run the migrations in
# supabase/migrations/ (in order) against this project before using the app —
# they create the teams/invitations/time-entries schema and the expenses +
# receipts schema, including the private "receipts" Storage bucket. Use the
# service role key only server-side — it bypasses row-level security.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A random secret of at least 32 characters. Never use a VITE_ prefix for secrets.
SESSION_SECRET=
APP_URL=http://localhost:8081
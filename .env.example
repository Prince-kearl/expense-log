# Google OAuth web-client credentials. Set the authorized redirect URI to
# ${APP_URL}/api/auth/google in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side service account. Share the spreadsheet and receipts folder with
# this service account. Keep the PEM on one line using literal \n characters.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_RECEIPTS_FOLDER_ID=

# A random secret of at least 32 characters. Never use a VITE_ prefix for secrets.
SESSION_SECRET=
APP_URL=http://localhost:8081
ALLOWED_EMAIL_DOMAIN=